# Copy to .env (never commit .env) or set these in your hosting provider's dashboard.
# Every value below except NODE_ENV/PORT/HOST/TRUST_PROXY/SITE_URL is sent to browsers via /config.js,
# so ONLY public client values belong here. Never put a Supabase service-role/secret key,
# Firebase Admin credentials or an Ozow private key in this file (the server refuses to start
# if SUPABASE_ANON_KEY looks like a service-role key).

NODE_ENV=production
# Public https origin, no trailing slash. Used for canonical URLs, sitemap and OG tags.
SITE_URL=https://www.your-domain.co.za
PORT=3000
HOST=0.0.0.0
# Number of reverse proxies in front of the app (Cloud Run/Render/Fly/Nginx = 1)
TRUST_PROXY=1

# Firebase web app (same Firebase project as the mobile app). Console > Project settings > Your apps.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Supabase project shared with the app. Use the anon / publishable key ONLY.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=

# Firebase App Check for the web (reCAPTCHA Enterprise site key; register the website domain).
RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional: Google Maps JavaScript API key (Places autocomplete + driver map).
# Restrict it to your website's HTTP referrers in Google Cloud.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Business details (TODO(owner)). Shown on the site only when set; nothing is shown otherwise.
# ---------------------------------------------------------------------------
# Customer support phone and email (contact page, accessibility page, structured data)
CONTACT_PHONE=
CONTACT_EMAIL=
# Information Officer email for POPIA requests (defaults to CONTACT_EMAIL)
PRIVACY_EMAIL=
# Free text, e.g. "Monday to Sunday, 07:00 to 20:00"
SUPPORT_HOURS=
# Comma separated, e.g. "Johannesburg, Pretoria, Cape Town, Durban"
SERVICE_AREAS=

# ---------------------------------------------------------------------------
# Mobile app (TODO(owner)). Download links stay hidden until the store URLs are set.
# ---------------------------------------------------------------------------
# https://apps.apple.com/za/app/...   and   https://play.google.com/store/apps/details?id=com.laundromatmarketplace
APP_STORE_URL=
PLAY_STORE_URL=
# Universal Links / App Links: website links (/orders/<id>, /book, /kyc) open the installed app.
# Apple Developer > Membership > Team ID (10 characters). Bundle id defaults to com.laundromat.marketplace.
APPLE_TEAM_ID=
# IOS_BUNDLE_ID=com.laundromat.marketplace
# Play Console > Setup > App integrity > App signing key certificate > SHA-256 (AA:BB:...).
# Comma separate several (e.g. the upload key too). Package defaults to com.laundromatmarketplace.
ANDROID_SHA256_CERT_FINGERPRINTS=
# ANDROID_PACKAGE=com.laundromatmarketplace
