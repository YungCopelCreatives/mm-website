# Copy to .env (never commit .env) or set these in your hosting provider's dashboard.

# Required in production
NODE_ENV=production
# Public https origin, no trailing slash. Used for canonical URLs, OG tags, sitemap.
SITE_URL=https://www.your-domain.co.za
# Random secret >= 32 chars for admin endpoints. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# Optional
PORT=3000
HOST=0.0.0.0
# Number of reverse proxies in front of the app (Cloud Run/Render/Fly/Nginx = 1)
TRUST_PROXY=1
# Where the JSON data store lives. Must be on persistent, backed-up storage.
DATA_FILE=./data/data_store.json
SESSION_TTL_HOURS=168
# Comma-separated promo codes worth R50 off
PROMO_CODES=MMWELCOME,SAVE50
